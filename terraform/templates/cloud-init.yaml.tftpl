#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.challengenet.oraclevcn.com
manage_etc_hosts: true

users:
  - name: admin
    gecos: Administrative Operator
    groups: [sudo, wheel]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: false
packages:
  - curl
  - git
  - nftables

runcmd:
  - systemctl enable nftables
